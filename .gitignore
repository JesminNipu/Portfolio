# ══════════════════════════════════════════════════
#  Jesmin Akther — Portfolio .gitignore
# ══════════════════════════════════════════════════

# ── SENSITIVE / LOCAL FILES ────────────────────────
# GitHub access token — NEVER COMMIT
settings.json
.env
.env.*
.env.local
.env.production

# Private credentials
*.pem
*.key
*.p12

# ── TEMPORARY EXTRACTION DIRECTORY ────────────────
_docx_extract/

# ── NODE / NPM ─────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── BUILD OUTPUTS (for future framework use) ───────
dist/
build/
.next/
.nuxt/
out/

# ── OS / EDITOR ────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# ── LOGS ───────────────────────────────────────────
*.log

# ══════════════════════════════════════════════════
# NOTE: index.html, assets/, .github/ ARE committed
# ══════════════════════════════════════════════════
